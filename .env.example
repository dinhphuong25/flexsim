# ==============================================================================
# Biến môi trường mẫu - Hệ thống Quản trị Chuyền May Việt Thành & Tích hợp FlexSim
# Lưu ý: Sao chép tệp này thành .env và điền các giá trị thực tế an toàn.
# Không đưa mật khẩu sản xuất hoặc khóa bí mật vào kho mã nguồn (git).
# ==============================================================================

# Cấu hình Database PostgreSQL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/flexsim_garment?schema=public"

# Khóa bí mật ký JWT Session (Độ dài tối thiểu 32 ký tự ngẫu nhiên)
AUTH_SECRET="viet-thanh-garment-group2-super-secret-jwt-key-2026-simulation"

# Thời hạn phiên đăng nhập (giây) - Mặc định 86400s (24 giờ)
AUTH_SESSION_MAX_AGE="86400"

# Cấu hình địa chỉ website (URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Môi trường thực thi (development | test | production)
NODE_ENV="development"

# Thiết lập khởi tạo tài khoản quản trị viên đầu tiên (Chỉ dùng khi khởi tạo ban đầu)
# Mật khẩu phải đổi ngay sau lần đăng nhập đầu tiên
INIT_ADMIN_USERNAME="admin@vietthanh.vn"
INIT_ADMIN_PASSWORD="Admin@VietThanh2026!ChangeMe"
INIT_ADMIN_FULLNAME="Quản Trị Viên Hệ Thống"

# Cấu hình tích hợp FlexSim Ingestion API
# Giới hạn dung lượng tải payload (bytes) - Mặc định 5MB
FLEXSIM_MAX_PAYLOAD_BYTES="5242880"

# Tần suất tối thiểu giữa các snapshot thời gian thực (mili giây) để chống tràn
FLEXSIM_MIN_SNAPSHOT_INTERVAL_MS="200"
